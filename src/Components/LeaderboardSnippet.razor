@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@inject JsonFileProductService ProductService

<div class="mt-4">
    @if (Players != null)
    {
        <div class="card shadow-sm leaderboard-snippet-container">
            <div class="card-header bg-gradient text-white dribble-kings-primary-bg">
                <h4 class="mb-0 py-2">@Title</h4>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var player in Players)
                    {
                        <li class="list-group-item   px-2 d-flex justify-content-between align-items-center py-3">
                            <div class="d-flex align-items-center">
                                <img src="@player.Image" class="rounded-circle me-3" alt="@player.Title" style="width: 40px; height: 40px; object-fit: cover;">
                                <div>
                                    <h6 class="mb-0 leaderboard-snippet-text-truncate">@player.Title</h6>
                                    <small class="text-muted leaderboard-snippet-text-truncate">@player.Club</small>
                                </div>
                            </div>
                            <div class="d-flex flex-column align-items-end">
                                @if (!string.IsNullOrEmpty(DisplayStat))
                                {
                                    var value = GetPropertyValue(player, DisplayStat);
                                    if (value != null)
                                    {
                                        <span class="badge bg-light shadow-sm rounded-pill fs-6 py-2 px-2 small">
                                            @DisplayStat: @value
                                        </span>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer bg-light">
                <a href="@ShowMoreUrl" class="btn btn-outline-primary w-100">
                    Show More
                </a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<ProductModel> Players { get; set; }

    [Parameter]
    public string ShowMoreUrl { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string DisplayStat { get; set; }

 
    public object GetPropertyValue(ProductModel player, string propertyName)
    {
        var property = player.GetType().GetProperty(propertyName);
        if (property == null)
        {
            return null;
        }
        return property.GetValue(player, null);
    }

}
