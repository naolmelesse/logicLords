@page
@model ContosoCrafts.WebSite.Pages.ComparePlayersModel
@{
    ViewData["Title"] = "Player Comparison";
}

<h1 style="text-align: center">@ViewData["Title"]</h1>

<div width: 100%; height: contain;">
    <form method="Get">
        <div style="text-align: center; border-right: 2px solid; width: 50%; height: auto; float:left;">
            <div class="px-5">
                <label for="dropdown1">Choose a player to compare:</label>
                <select asp-for="SelectedPlayerLeftId" class="form-control" asp-items="Model.PlayerDropDownItems" onchange="this.form.submit()">
                    <option value="">-- Select Player --</option>
                </select>
            </div>
            <img id="playerImageLeft" src="https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png"
                 alt="player Image Left" style="width: 300px; height: 300px; object-fit: cover; margin-bottom: 10px;" />
        </div>

        <div style="text-align: center; width:50%; height: auto; float:left;">
            <div class="px-5">
                <label for="dropdown2">Choose a player to compare:</label>
                <select asp-for="SelectedPlayerRightId" class="form-control" asp-items="Model.PlayerDropDownItems" onchange="this.form.submit()">
                    <option value="">-- Select Player --</option>
                </select>
            </div>
            <img id="playerImageRight" src="https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png"
                 alt="player Image Right" style="width: 300px; height: 300px; object-fit: cover; margin-bottom: 10px;" />
        </div>

    </form>
        <div class="comparison-list-container">
            <p>Place of birth</p>
            <p>Date of birth</p>
            <p>Club</p>
            <p>Height</p>
            <p>Positions</p>
            <p>Goals</p>
            <p>Assists</p>
            <p>Appearances</p>
            <p>Minutes played</p>
        </div>
</div>  