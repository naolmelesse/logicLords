@page
@model ContosoCrafts.WebSite.Pages.ComparePlayersModel
@{
    ViewData["Title"] = "Player Comparison";
}

<h1 class="title">@ViewData["Title"]</h1>



    <form method="Get">
    <div class="comparison-container">
        <!-- Left Player Card -->
    <div class="player-card">
            <label for="dropdown1">Choose a player to compare:</label>
            <select asp-for="SelectedPlayerLeftId" class="form-control" asp-items="Model.PlayerDropDownItems" onchange="this.form.submit()">
                <option value="">-- Select Player --</option>
            </select>

            <div class="player-image">
                @if (Model.SelectedPlayerLeft != null)
                {
                    <img id="playerImageLeft"
                         src="@(Model.SelectedPlayerLeft.Image == null ? "https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png" : Model.SelectedPlayerLeft.Image)"
                         onerror="this.src='https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png'; this.onerror=null;"
                         alt="Player Image Left" />

                }
                @if (Model.SelectedPlayerLeft == null)
                {
                    <img id="playerImageLeft" src="https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png" alt="player Image Left" />
                }
            </div>

            <div class="player-details">
                @if (Model.SelectedPlayerLeft != null)
                {
                    <p>@Model.SelectedPlayerLeft.Placeofbirth</p>
                    <p>@Model.SelectedPlayerLeft.Dateofbirth</p>
                    <p>@Model.SelectedPlayerLeft.Club</p>
                    <p>@Model.SelectedPlayerLeft.Height</p>
                    <p>@Model.SelectedPlayerLeft.Position</p>
                    <p>@Model.SelectedPlayerLeft.Goals</p>
                    <p>@Model.SelectedPlayerLeft.Assists</p>
                    <p>@Model.SelectedPlayerLeft.Appearances</p>
                    <p>@Model.SelectedPlayerLeft.Minutesplayed</p>
                }
                @if (Model.SelectedPlayerLeft == null)
                {
                    <p>No player selected</p>
                }
            </div>
        
    </div>

    <!-- Comparison Stats Column -->
        <div class="comparison-stats">
            <p><strong>⚔️ Comparison ⚔️</strong></p>
            <p>🌍 Place of birth 🌍</p>
            <p>📅 Date of birth 📅</p>
            <p>🏟️ Club 🏟️</p>
            <p>📏 Height 📏</p>
            <p>⚽ Position ⚽</p>
            <p>🥅 Goals 🥅</p>
            <p>🎯 Assists 🎯</p>
            <p>👕 Appearances 👕</p>
            <p>⏱️ Minutes played ⏱️</p>
        </div>


    <!-- Right Player Card -->
    <div class="player-card">
        <label for="dropdown2">Choose a player to compare:</label>
        <select asp-for="SelectedPlayerRightId" class="form-control" asp-items="Model.PlayerDropDownItems" onchange="this.form.submit()">
            <option value="">-- Select Player --</option>
        </select>

        <div class="player-image">
            @if (Model.SelectedPlayerRight != null)
            {
                    <img id="playerImageRight"
                         src="@(Model.SelectedPlayerRight.Image == null ? "https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png" : Model.SelectedPlayerRight.Image)"
                         onerror="this.src='https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png'; this.onerror=null;"
                         alt="Player Image Right" />
                }
            @if (Model.SelectedPlayerRight == null)
            {
                <img id="playerImageRight" src="https://static.sky.it/images/skysport/configurations/placeholders/football/SkySpport-player_placeholder.png" alt="player Image Right" />
            }
        </div>

        <div class="player-details">
            @if (Model.SelectedPlayerRight != null)
            {
                <p>@Model.SelectedPlayerRight.Placeofbirth</p>
                <p>@Model.SelectedPlayerRight.Dateofbirth</p>
                <p>@Model.SelectedPlayerRight.Club</p>
                <p>@Model.SelectedPlayerRight.Height</p>
                <p>@Model.SelectedPlayerRight.Position</p>
                <p>@Model.SelectedPlayerRight.Goals</p>
                <p>@Model.SelectedPlayerRight.Assists</p>
                <p>@Model.SelectedPlayerRight.Appearances</p>
                <p>@Model.SelectedPlayerRight.Minutesplayed</p>
            }
            @if (Model.SelectedPlayerRight == null)
            {
                <p>No player selected</p>
            }
        </div>
    </div>

    </div>
    </form>

