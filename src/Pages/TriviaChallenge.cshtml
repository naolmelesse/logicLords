@page
@model ContosoCrafts.WebSite.Pages.TriviaChallengeModel
@{
    ViewData["Title"] = "Trivia Challenge";
}

<div class="container-fluid bg-dark text-white min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card bg-secondary text-white" style="max-width: 800px;">
        <div class="card-header bg-primary text-center">
            <h1 class="h3 mb-0">Trivia Challenge</h1>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 text-center">
<div class="position-relative mb-3">
    <svg viewBox="0 0 100 100" class="wheel @(Model.IsSpinning ? "spinning" : "")">
        <circle cx="50" cy="50" r="45" fill="#2C3E50" />
        @for (int i = 0; i < 8; i++)
        {
            double angle = i * 45;
            @: <text x="50" y="10" text-anchor="middle" fill="#3498DB" font-size="5" transform="rotate(@(angle) 50 50)">@Model.Categories[i % Model.Categories.Length]</text>
        }
        <circle cx="50" cy="50" r="40" fill="#34495E" />
    </svg>
    <div class="wheel-pointer"></div>
</div>

                    <form method="post">
                        <button type="submit" asp-page-handler="SpinWheel" 
                                disabled="@Model.IsSpinning"
                                class="btn btn-primary @(Model.IsSpinning ? "disabled" : "")">
                            @(Model.IsSpinning ? "Spinning..." : "Spin the Wheel")
                        </button>
                    </form>
                </div>
                <div class="col-md-6">
                    <div class="bg-dark p-3 rounded">
                        @if (Model.CurrentCategory != null)
                        {
                            <div>
                                <h2 class="h4 text-info mb-3">Category: @Model.CurrentCategory</h2>
                                
                                @if (Model.CurrentQuestion != null)
                                {
                                    <div>
                                        <p class="mb-3">@Model.CurrentQuestion.QuestionText</p>
                                        
                                        <div class="d-grid gap-2">
                                            <form method="post">
                                                @foreach (var option in Model.CurrentQuestion.Options)
                                                {
                                                    <button type="submit" 
                                                            asp-page-handler="CheckAnswer"
                                                            asp-route-selectedOption="@option"
                                                            disabled="@(Model.SelectedAnswer != null)"
                                                            class="btn @(Model.GetButtonClass(option))">
                                                        @option
                                                    </button>
                                                }
                                            </form>
                                        </div>

                                        @if (Model.SelectedAnswer != null)
                                        {
                                            <div class="alert @(Model.IsCorrectAnswer ? "alert-success" : "alert-danger") mt-3">
                                                @(Model.IsCorrectAnswer 
                                                    ? "Correct! Great job!" 
                                                    : $"Incorrect. The correct answer was: {Model.CurrentQuestion.CorrectAnswer}")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center">Spin the wheel to start your trivia challenge!</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>