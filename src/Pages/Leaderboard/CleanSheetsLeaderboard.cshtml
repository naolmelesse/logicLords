@page
@model ContosoCrafts.WebSite.Pages.Leaderboard.CleanSheetsLeaderboardModel

@{
    ViewData["Title"] = "Clean Sheets Leaderboard";
}

<div>
    <div class="container mt-5">
        <h1 class="text-center">@ViewData["Title"]</h1>
        <table class="table table-striped">
            <thead class="leaderboard">
                <tr>
                    <th scope="col">Player</th>
                    <th scope="col">Clean Sheets</th>
                    <th scope="col">Matches Played</th>
                    <th scope="col">Position</th>                    
                    <th scope="col">Club</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.PlayerList)
                {
                    <tr>
                        <td data-label="Player">@player.Title</td>
                        <td data-label="Clean Sheets">@player.CleanSheets</td>
                        <td data-label="Matches Played">@player.Appearances</td>
                        <td data-label="Position">@player.Position</td>
                        <td data-label="Club">@player.Club</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>