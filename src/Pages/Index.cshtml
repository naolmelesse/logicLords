@page
@using ContosoCrafts.WebSite.Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-home">
    <h1>Logic Lords</h1>
    <div class="container my-5 justify-content-center home-search-container">
        <h2 class="search-heading">Filter and Search</h2>
        <form method="get" asp-page-handler="Search" class="search-form">

            <!-- Text box for search input -->
            <div class="search-input-container container my-1">
                <input type="text" name="SearchTerm" class="form-control search-input" placeholder="Search..." value="@Model.SearchTerm" />
            </div>

            <div class="filters-container">
                <!--Age Filter-->
                <div class="age-filter row justify-content-center align-items-center">
                    <label class="age-label m-0">Age Range:</label>
                    <select name="MinAge" class="form-control age-dropdown mx-2 col-md-2">
                        <option value="">Min Age</option>
                        @for (int age = 16; age <= 40; age++)
                        {
                            <option value="@age" selected="@(Model.MinAge == age ? "selected" : null)">@age</option>
                        }
                    </select>
                    -
                    <select name="MaxAge" class="form-control age-dropdown mx-2 col-md-2">
                        <option value="">Max Age</option>
                        @for (int age = 16; age <= 40; age++)
                        {
                            <option value="@age" selected="@(Model.MaxAge == age ? "selected" : null)">@age</option>
                        }
                    </select>
                </div>

                <!-- Appearance Filter -->
                <div class="appearance-filter row justify-content-center align-items-center mt-1">
                    <label class="appearance-label m-0">Appearance Range:</label>
                    <select name="MinAppearance" class="form-control appearance-dropdown mx-2 col-md-2">
                        <option value="">Min Appearance</option>
                        @for (int appearance = 16; appearance <= 40; appearance++)
                        {
                            <option value="@appearance" selected="@(Model.MinAppearance == appearance ? "selected" : null)">@appearance</option>
                        }
                    </select>
                    -
                    <select name="MaxAppearance" class="form-control appearance-dropdown mx-2 col-md-2">
                        <option value="">Max Appearance</option>
                        @for (int appearance = 16; appearance <= 40; appearance++)
                        {
                            <option value="@appearance" selected="@(Model.MaxAppearance == appearance ? "selected" : null)">@appearance</option>
                        }
                    </select>
                </div>

                <!-- Position Filter -->
                <div class="position-filter row justify-content-center align-items-center mt-3">
                    <label class="position-label m-0">Position:</label>
                    <select name="Position" class="form-control position-dropdown mx-2 col-md-4">
                        <option value="">Select Position</option>
                        <option value="Forward" selected="@(Model.Position == "Forward" ? "selected" : null)">Forward</option>
                        <option value="Striker" selected="@(Model.Position == "Striker" ? "selected" : null)">Striker</option>
                        <option value="Winger" selected="@(Model.Position == "Winger" ? "selected" : null)">Winger</option>
                        <option value="Midfielder" selected="@(Model.Position == "Midfielder" ? "selected" : null)">Midfielder</option>
                    </select>
                </div>

                <!-- Height Filter -->
                <div class="height-filter row justify-content-center align-items-center mt-3">
                    <label class="height-label m-0">Height:</label>
                    <select name="Height" class="form-control height-dropdown mx-2 col-md-4">
                        <option value="">Select Height Range</option>
                        <option value="< 155 cm" selected="@(Model.Height == "< 155 cm" ? "selected" : null)">< 155 cm</option>
                        <option value="155 cm - 164 cm" selected="@(Model.Height == "155 cm - 164 cm" ? "selected" : null)">155 cm - 164 cm</option>
                        <option value="165 cm - 174 cm" selected="@(Model.Height == "165 cm - 174 cm" ? "selected" : null)">165 cm - 174 cm</option>
                        <option value="175 cm - 184 cm" selected="@(Model.Height == "175 cm - 184 cm" ? "selected" : null)">175 cm - 184 cm</option>
                        <option value="185 cm - 194 cm" selected="@(Model.Height == "185 cm - 194 cm" ? "selected" : null)">185 cm - 194 cm</option>
                        <option value="> 195 cm" selected="@(Model.Height == "> 195 cm" ? "selected" : null)">> 195 cm</option>
                    </select>
                </div>
            </div>

            <!-- Search Button -->
            <button type="submit" class="btn btn-primary search-button">Search</button>
        </form>

        <!-- Display Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }
    </div>

    @(await Html.RenderComponentAsync<ProductList>(
        RenderMode.ServerPrerendered,
        new { Players = Model.SelectedPlayerList ?? Model.PlayerList }))
</div>

<script src="_framework/blazor.server.js"></script>
