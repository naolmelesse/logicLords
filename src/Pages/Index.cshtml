@page
@using ContosoCrafts.WebSite.Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div class="banner">
    <div class='banner-upper'>
        <h1>DRIBBLE KINGS</h1>
        <div class="banner-text">
            <p>Home of players.</p>
            <p>know more about your favorite player.</p>
        </div>

    </div>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <a href="#search" class="btn btn-get-started">
            Get Started <i class="bi bi-chevron-right"></i>
        </a>
    </div>
</div>
<div class="container-home">
    <h1>Logic Lords</h1>
    <h2>Leaderboards</h2>
    <div class="container">
        <div class="row g-3 justify-content-center my-3">
            <div class="col-auto">
                <a href="/leaderboard/goalsleaderboard" class="btn btn-outline-primary">
                    <i class="fa fa-futbol-o me-1"></i>Goals Leaderboard
                </a>
            </div>
            <div class="col-auto">
                <a href="/leaderboard/assistsleaderboard" class="btn btn-outline-primary">
                    <i class="fa fa-hand-peace-o me-1"></i>Assists Leaderboard
                </a>
            </div>
            <div class="col-auto">
                <a href="/leaderboard/savesleaderboard" class="btn btn-outline-primary">
                    <i class="fa fa-shield me-1"></i>Saves Leaderboard
                </a>
            </div>
            <div class="col-auto">
                <a href="/leaderboard/cleansheetsleaderboard" class="btn btn-outline-primary">
                    <i class="fa fa-lock me-1"></i>Clean Sheets Leaderboard
                </a>
            </div>
        </div>
    </div>
    <div class="home-player-list-container p-1 p-md-4 p-sm-1 mt-4">
        <div class="container my-5 justify-content-center home-search-container">
            <h2 class="search-heading" id="search">Filter and Search</h2>
            <form method="get" asp-page-handler="Search" class="">

                <!-- Text box for search input -->
                <div class="d-flex my-1">
                    <input type="text" name="SearchTerm" class="form-control flex-grow-1" placeholder="Search..." value="@Model.SearchTerm" />
                    <button type="submit" class="btn btn-primary px-3 ml-2">Search</button>
                </div>

                <div class="row">
                    <!--Age Filter-->
                    <div class="age-filter col-12 col-md-6 mt-3">
                        <label class="age-label m-0 w-100 pl-3">Age Range:</label>
                        <div class="row justify-content-center">
                            <select name="MinAge" class="search-filter-dropdown col-5 age-dropdown">
                                <option value="">Min Age</option>
                                @for (int age = 16; age <= 40; age++)
                                {
                                    <option value="@age" selected="@(Model.MinAge == age ? "selected" : null)">@age</option>
                                }
                            </select>
                            <div class="mx-2">-</div>
                            <select name="MaxAge" class="search-filter-dropdown col-5 age-dropdown">
                                <option value="">Max Age</option>
                                @for (int age = 16; age <= 40; age++)
                                {
                                    <option value="@age" selected="@(Model.MaxAge == age ? "selected" : null)">@age</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Appearance Filter -->
                    <div class="appearance-filter  col-12 col-md-6 mt-3">
                        <label class="appearance-label m-0 w-100 pl-3">Appearance Range:</label>
                        <div class="row justify-content-center">
                            <select name="MinAppearance" class="search-filter-dropdown appearance-dropdown col-5">
                                <option value="">Min Appearance</option>
                                @for (int appearance = 16; appearance <= 40; appearance++)
                                {
                                    <option value="@appearance" selected="@(Model.MinAppearance == appearance ? "selected" : null)">@appearance</option>
                                }
                            </select>
                            <div class="mx-2">-</div>
                            <select name="MaxAppearance" class="search-filter-dropdown col-5 appearance-dropdown ">
                                <option value="">Max Appearance</option>
                                @for (int appearance = 16; appearance <= 40; appearance++)
                                {
                                    <option value="@appearance" selected="@(Model.MaxAppearance == appearance ? "selected" : null)">@appearance</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Position Filter -->
                    <div class="position-filter col-12 col-md-6 pr-4 mt-3">
                        <label class="position-label m-0 w-100 pl-3">Position:</label>
                        <select name="Position" class="search-filter-dropdown position-dropdown mx-2">
                            <option value="">Select Position</option>
                            <option value="Forward" selected="@(Model.Position == "Forward" ? "selected" : null)">Forward</option>
                            <option value="Striker" selected="@(Model.Position == "Striker" ? "selected" : null)">Striker</option>
                            <option value="Winger" selected="@(Model.Position == "Winger" ? "selected" : null)">Winger</option>
                            <option value="Midfielder" selected="@(Model.Position == "Midfielder" ? "selected" : null)">Midfielder</option>
                        </select>
                    </div>

                    <!-- Height Filter -->
                    <div class="height-filter col-12 col-md-6 pr-4 mt-3">
                        <label class="height-label m-0 w-100 pl-3">Height:</label>
                        <select name="Height" class="search-filter-dropdown height-dropdown mx-2 col-md-">
                            <option value="">Select Height Range</option>
                            <option value="< 155 cm" selected="@(Model.Height == "< 155 cm" ? "selected" : null)">< 155 cm</option>
                            <option value="155 cm - 16 cm" selected="@(Model.Height == "155 cm - 16 cm" ? "selected" : null)">155 cm - 16 cm</option>
                            <option value="165 cm - 17 cm" selected="@(Model.Height == "165 cm - 17 cm" ? "selected" : null)">165 cm - 17 cm</option>
                            <option value="175 cm - 18 cm" selected="@(Model.Height == "175 cm - 18 cm" ? "selected" : null)">175 cm - 18 cm</option>
                            <option value="185 cm - 19 cm" selected="@(Model.Height == "185 cm - 19 cm" ? "selected" : null)">185 cm - 19 cm</option>
                            <option value="> 195 cm" selected="@(Model.Height == "> 195 cm" ? "selected" : null)">> 195 cm</option>
                        </select>
                    </div>
                </div>
            </form>

            <!-- Display Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-4">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }
        </div>

        @(await Html.RenderComponentAsync<ProductList>(
            RenderMode.ServerPrerendered,
            new { Players = Model.SelectedPlayerList ?? Model.PlayerList }))
    </div>
</div>

<script src="_framework/blazor.server.js"></script>
