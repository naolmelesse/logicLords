@page
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel
@{
    ViewData["Title"] = "Update Player";
}
<h2>@ViewData["Title"]</h2>

@if (Model.Player != null)
{
    <form method="post">
        <input type="hidden" asp-for="Player.Id" />
        <div>
            <label asp-for="Player.Title">Name:</label>
            <input asp-for="Player.Title" />
        </div>
        <div>
            <label asp-for="Player.Dateofbirth">Date of Birth:</label>
            <input asp-for="Player.Dateofbirth" />
        </div>
        <div>
            <label asp-for="Player.Placeofbirth">Place of Birth:</label>
            <input asp-for="Player.Placeofbirth" />
        </div>
        <div>
            <label asp-for="Player.Height">Height:</label>
            <input asp-for="Player.Height" />
        </div>
        <div>
            <label asp-for="Player.Position">Position:</label>
            <input asp-for="Player.Position" />
        </div>
        <div>
            <label asp-for="Player.Club">Current Team:</label>
            <input asp-for="Player.Club" />
        </div>

        <div>
            <label asp-for="Player.Appearances">Games Played:</label>
            <input asp-for="Player.Appearances" />
        </div>
        <div>
            <label asp-for="Player.Minutesplayed">Minutes Played:</label>
            <input asp-for="Player.Minutesplayed" />
        </div>
        <div>
            <label asp-for="Player.Goals">Goals:</label>
            <input asp-for="Player.Goals" />
        </div>
        <div>
            <label asp-for="Player.Assists">Assists:</label>
            <input asp-for="Player.Assists" />
        </div>
        <div>
            <label asp-for="Player.Image">Image Path:</label>
            <input asp-for="Player.Image" />
        </div>
        <div>
            <input type="submit" value="Save Changes" />
        </div>
    </form>
}