@page
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel
@{
    ViewData["Title"] = "Update Player";
}

<div class="update-page-container">
    <div class="content-wrapper">
        <h2 class="page-title">@ViewData["Title"]</h2>
        @if (Model.Player != null)
        {
            <form method="post" class="player-form">
                <input type="hidden" asp-for="Player.Id" />
                
                <div class="form-group">
                    <label asp-for="Player.Title">Name:</label>
                    <input asp-for="Player.Title" class="form-input" />
                    <span asp-validation-for="Player.Title" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Dateofbirth">Date of Birth:</label>
                    <input asp-for="Player.Dateofbirth" class="form-input" type="date" />
                    <span asp-validation-for="Player.Dateofbirth" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Placeofbirth">Place of Birth:</label>
                    <input asp-for="Player.Placeofbirth" class="form-input" />
                    <span asp-validation-for="Player.Placeofbirth" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.HeightInCMs">Height(cm):</label>
                    <input asp-for="Player.HeightInCMs" class="form-input" />
                    <span asp-validation-for="Player.HeightInCMs" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Position">Position:</label>
                    <select asp-for="Player.Position" class="form-input" asp-items="Model.PositionOptions">
                        <option value="0">Select Position</option>
                    </select>
                    <span asp-validation-for="Player.Position" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Player.Club">Current Team:</label>
                    <input asp-for="Player.Club" class="form-input" />
                    <span asp-validation-for="Player.Club" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Appearances">Games Played:</label>
                    <input asp-for="Player.Appearances" class="form-input" type="number" />
                    <span asp-validation-for="Player.Appearances" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Minutesplayed">Minutes Played:</label>
                    <input asp-for="Player.Minutesplayed" class="form-input" type="number" />
                    <span asp-validation-for="Player.Minutesplayed" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Goals">Goals:</label>
                    <input asp-for="Player.Goals" class="form-input" type="number" />
                    <span asp-validation-for="Player.Goals" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Assists">Assists:</label>
                    <input asp-for="Player.Assists" class="form-input" type="number" />
                    <span asp-validation-for="Player.Assists" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.CleanSheets">Clean Sheets:</label>
                    <input asp-for="Player.CleanSheets" class="form-input" />
                    <span asp-validation-for="Player.CleanSheets" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Saves">Saves: </label>
                    <input asp-for="Player.Saves" class="form-input" />
                    <span asp-validation-for="Player.Saves" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="Player.Image">Image Path:</label>
                    <input asp-for="Player.Image" class="form-input" />
                    <span asp-validation-for="Player.Image" class="text-danger"></span>

                </div>

                <div class="form-group submit-group">
                    <input type="submit" value="Save Changes" class="submit-button" />
                </div>
            </form>
        }
    </div>
</div>
