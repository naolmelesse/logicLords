@page "{id}"
@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using ContosoCrafts.WebSite.Components
@model ReadModel
@{
    ViewData["Title"] = "Player Details";
}

<div class="read-delete-page-container">
    <div class="content-wrapper">
        <h1 class="page-title">Player Information</h1>

        <div class="player-data-container">
            @(await Html.RenderComponentAsync<PlayerData>(RenderMode.ServerPrerendered, new { Id = Model.Id }))
        </div>
    </div>
</div>