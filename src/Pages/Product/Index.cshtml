@page
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Index page";
}

<div class="container">
    <div class="d-flex">
        <a asp-page="Create" class="btn btn-lg btn-primary ml-auto my-3 px-4">Create</a>
    </div>
    <table class="table table-bordered table-striped index-page-table " >
        <thead>
            <tr>
                <th>Title</th>
                <th colspan="3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Title</td>
                    <div class="index-action-button-container">
                        <td class="index-action-button"><a asp-page="Read" asp-route-id="@product.Id">Read</a></td>
                        <td class="index-action-button"><a asp-page="Update" asp-route-id="@product.Id">Update</a></td>
                        <td class="index-action-button"><a asp-page="Delete" asp-route-id="@product.Id">Delete</a></td>
                    </div>                    
                </tr>
            }
        </tbody>
    </table>
</div>