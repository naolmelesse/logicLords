@page
@model ContosoCrafts.WebSite.Pages.Product.CreateModel
@{
    ViewData["Title"] = "Create Player";
}
<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Title" class="form-label">Name:</label>
            <input asp-for="Player.Title" class="form-control" />
            <span asp-validation-for="Player.Title" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Dateofbirth" class="form-label">Date of Birth:</label>
            <input asp-for="Player.Dateofbirth" class="form-control" />
            <span asp-validation-for="Player.Dateofbirth" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Placeofbirth" class="form-label">Place of Birth:</label>
            <input asp-for="Player.Placeofbirth" class="form-control" />
            <span asp-validation-for="Player.Placeofbirth" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Player.HeightInCMs" class="form-label">Height (cm):</label>
            <input asp-for="Player.HeightInCMs" class="form-control" />
            <span asp-validation-for="Player.HeightInCMs" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Position" class="form-label">Position:</label>
            <input asp-for="Player.Position" class="form-control" />
            <span asp-validation-for="Player.Position" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Club" class="form-label">Current Team:</label>
            <input asp-for="Player.Club" class="form-control" />
            <span asp-validation-for="Player.Club" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Appearances" class="form-label">Games Played:</label>
            <input asp-for="Player.Appearances" class="form-control" />
            <span asp-validation-for="Player.Appearances" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Minutesplayed" class="form-label">Minutes Played:</label>
            <input asp-for="Player.Minutesplayed" class="form-control" />
            <span asp-validation-for="Player.Minutesplayed" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Goals" class="form-label">Goals:</label>
            <input asp-for="Player.Goals" class="form-control" />
            <span asp-validation-for="Player.Goals" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Player.Assists" class="form-label">Assists:</label>
            <input asp-for="Player.Assists" class="form-control" />
            <span asp-validation-for="Player.Assists" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <label asp-for="Player.Image" class="form-label">Image Path:</label>
            <input asp-for="Player.Image" class="form-control" />
            <span asp-validation-for="Player.Image" class="text-danger"></span>
        </div>
    </div>

    <div class="my-4 d-flex justify-content-end">
        <button type="submit" class="px-4 py-2 btn btn-primary">Save Changes</button>
    </div>
</form>